<%- include('partials/header') %>

<div class="container py-5 my-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <!-- Success Icon -->
            <div class="mb-4">
                <div class="rounded-circle bg-success d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <i class="fas fa-check text-white fa-3x"></i>
                </div>
            </div>

            <h1 class="display-5 fw-bold text-success mb-3">Teşekkürler, Siparişiniz Alındı!</h1>
            <p class="lead text-muted mb-4">
                Sipariş numaranız: <span class="fw-bold text-dark">#TR-<%= order.id %></span>
            </p>
            <p class="text-muted mb-5">
                Sipariş detaylarını ve kargo durumunu aşağıdan takip edebilirsiniz.
            </p>

            <!-- Tracking Timeline -->
            <div class="position-relative mb-5 mx-4">
                <div class="progress" style="height: 4px; background-color: #e9ecef;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: 15%;" aria-valuenow="15" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                
                <div class="d-flex justify-content-between position-absolute top-0 w-100" style="transform: translateY(-50%);">
                    <!-- Step 1 -->
                    <div class="text-center" style="margin-left: -5%;">
                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 50px; height: 50px; border: 4px solid #fff; box-shadow: 0 0 0 2px #198754;">
                            <i class="fas fa-clipboard-check"></i>
                        </div>
                        <h6 class="fw-bold mb-0">Sipariş Alındı</h6>
                        <small class="text-muted">Bugün</small>
                    </div>

                    <!-- Step 2 -->
                    <div class="text-center">
                        <div class="bg-light text-muted rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 50px; height: 50px; border: 4px solid #fff; box-shadow: 0 0 0 2px #dee2e6;">
                            <i class="fas fa-box-open"></i>
                        </div>
                        <h6 class="fw-bold mb-0 text-muted">Hazırlanıyor</h6>
                        <small class="text-muted">Bekleniyor</small>
                    </div>

                    <!-- Step 3 -->
                    <div class="text-center">
                        <div class="bg-light text-muted rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 50px; height: 50px; border: 4px solid #fff; box-shadow: 0 0 0 2px #dee2e6;">
                            <i class="fas fa-shipping-fast"></i>
                        </div>
                        <h6 class="fw-bold mb-0 text-muted">Kargoya Verildi</h6>
                        <small class="text-muted">Bekleniyor</small>
                    </div>

                    <!-- Step 4 -->
                    <div class="text-center" style="margin-right: -5%;">
                        <div class="bg-light text-muted rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 50px; height: 50px; border: 4px solid #fff; box-shadow: 0 0 0 2px #dee2e6;">
                            <i class="fas fa-home"></i>
                        </div>
                        <h6 class="fw-bold mb-0 text-muted">Teslim Edildi</h6>
                        <small class="text-muted">Tahmini: 3 Gün</small>
                    </div>
                </div>
            </div>

            <!-- Info Alert -->
            <div class="alert alert-light border d-flex align-items-center mt-5" role="alert">
                <i class="fas fa-info-circle text-primary fs-4 me-3"></i>
                <div class="text-start">
                    <strong>Bilgilendirme:</strong> Siparişiniz hazırlandığında size SMS ve E-posta ile bilgilendirme yapılacaktır.
                </div>
            </div>

            <div class="mt-5">
                <a href="/products" class="btn btn-outline-dark btn-lg rounded-0 px-5">Alışverişe Devam Et</a>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
