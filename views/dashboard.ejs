<%- include('partials/header') %>

<div class="container-fluid py-4">
    <div class="row">
        <!-- Sidebar / Header Area -->
        <div class="col-12 mb-4">
            <div class="d-flex justify-content-between align-items-center bg-dark text-white p-3 rounded">
                <h2 class="h4 mb-0 font-serif">Satıcı Merkezi</h2>
                <div>
                    <a href="/admin/orders" class="btn btn-primary btn-sm me-2"><i class="fas fa-shopping-cart"></i> Siparişler</a>
                    <a href="/" class="btn btn-outline-light btn-sm">Siteye Dön</a>
                </div>
            </div>
        </div>

        <!-- Left Column: Actions -->
        <div class="col-lg-4 mb-4">
            <!-- Quick Add Widget -->
            <div class="card shadow-sm border-0 mb-4 bg-light">
                <div class="card-body text-center p-4">
                    <h5 class="card-title fw-bold mb-3">Hızlı Ekle</h5>
                    <p class="text-muted small mb-4">İsim veya detay girmeden anında taslak ürün oluşturun.</p>
                    <form action="/products/quick" method="POST">
                        <button type="submit" class="btn btn-warning w-100 py-3 fw-bold text-uppercase">
                            <i class="fas fa-bolt me-2"></i> Taslak Ürün Ekle
                        </button>
                    </form>
                </div>
            </div>

            <!-- Manual Add Form -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">Yeni Ürün Ekle</h5>
                </div>
                <div class="card-body">
                    <form action="/products" method="POST" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label small text-muted">Ürün Başlığı</label>
                            <input type="text" class="form-control" name="name" required>
                        </div>
                        
                        <div class="row g-2">
                            <div class="col-4 mb-3">
                                <label class="form-label small text-muted">Fiyat (TL/$)</label>
                                <input type="number" class="form-control" name="price" required>
                            </div>
                            <div class="col-4 mb-3">
                                <label class="form-label small text-muted">Kategori</label>
                                <select class="form-select" name="category">
                                    <option value="Classic">Klasik</option>
                                    <option value="Sport">Spor</option>
                                    <option value="Luxury">Lüks</option>
                                    <option value="Smart">Akıllı</option>
                                </select>
                            </div>
                            <div class="col-4 mb-3">
                                <label class="form-label small text-muted">Cinsiyet</label>
                                <select class="form-select" name="gender">
                                    <option value="Men">Erkek</option>
                                    <option value="Women">Kadın</option>
                                    <option value="Unisex">Unisex</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small text-muted">Marka</label>
                            <input type="text" class="form-control" name="brand" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small text-muted">Görsel (Dosya Yükle)</label>
                            <input type="file" class="form-control mb-2" name="image" accept="image/*">
                            <div class="text-center small text-muted mb-2">- VEYA -</div>
                            <label class="form-label small text-muted">Görsel (URL)</label>
                            <input type="text" class="form-control" name="image_url" placeholder="https://...">
                        </div>

                        <div class="mb-3">
                            <label class="form-label small text-muted">Açıklama</label>
                            <textarea class="form-control" name="description" rows="3" required></textarea>
                        </div>

                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="featured" name="featured" value="true">
                            <label class="form-check-label small" for="featured">Ana Sayfada Göster</label>
                        </div>

                        <button type="submit" class="btn btn-dark w-100">Ürünü Kaydet</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right Column: Inventory List -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">Mevcut Envanter</h5>
                    <span class="badge bg-secondary"><%= products.length %> Ürün</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Görsel</th>
                                    <th>Ürün Adı</th>
                                    <th>Kategori</th>
                                    <th>Fiyat</th>
                                    <th class="text-end pe-4">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% products.forEach(product => { %>
                                    <tr>
                                        <td class="ps-4">
                                            <img src="<%= product.image %>" class="rounded" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/50'">
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark"><%= product.name %></div>
                                            <small class="text-muted"><%= product.brand %></small>
                                        </td>
                                        <td><span class="badge bg-light text-dark border"><%= product.category %></span></td>
                                        <td class="fw-bold text-success">$<%= product.price.toLocaleString() %></td>
                                        <td class="text-end pe-4">
                                            <a href="/products/<%= product.id %>/edit" class="btn btn-sm btn-outline-primary me-1" title="Düzenle">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form action="/products/<%= product.id %>?_method=DELETE" method="POST" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Silmek istediğinize emin misiniz?')" title="Sil">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
